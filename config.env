# =============================================================================
# semscan environment variable template (can be submitted to repository)
#
# Usage:
#   1. Copy this file to .env in the project root directory (or any other name, specify with --dotenv at runtime)
#   2. Replace the placeholders with your actual configuration; do not submit the .env file with keys to Git
#
# Loading rules (see src/semscan/config/config.py):
#   - Keys already existing in the operating system environment variables will not be overridden by .env
#   - Programmatically read PLANNER_* / WORKER_* first, then read OPENAI_* as a compatibility alias if not set
# =============================================================================

# -----------------------------------------------------------------------------
# Planner (main Agent / comprehensive planning) — OpenAI compatible HTTP API
# -----------------------------------------------------------------------------
# Required (when LLM is enabled): at least set API Key; can use OPENAI_API_KEY instead of PLANNER_API_KEY
PLANNER_API_KEY=
# Optional: API root address, must end with /v1 or be consistent with the server agreement (default below OPENAI compatible items)
PLANNER_BASE_URL=
# Optional: model name (default below)
PLANNER_MODEL=

# -----------------------------------------------------------------------------
# Worker (sub-Agent / tool-side LLM) — can use the same service provider as Planner or configure separately
# -----------------------------------------------------------------------------
# If not filled, automatically inherit Planner's Key / Base URL / Model
WORKER_API_KEY=
WORKER_BASE_URL=
WORKER_MODEL=

# -----------------------------------------------------------------------------
# Compatibility alias (if only the following three items are filled, Planner and Worker will share them when not configured separately)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Other compatible interface semscans (uncomment the corresponding line and fill in; still use OPENAI_* or PLANNER_* variable names)
# -----------------------------------------------------------------------------
# DeepSeek:
# PLANNER_BASE_URL=https://api.deepseek.com/v1
# PLANNER_MODEL=deepseek-chat
# SiliconFlow etc. OpenAI compatible gateway:
# PLANNER_BASE_URL=https://api.siliconflow.cn/v1
# PLANNER_MODEL=...
